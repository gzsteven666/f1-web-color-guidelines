{
  "name": "f1-web-color-guidelines",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:templates": "node scripts/build-templates.mjs",
    "build:templates:check": "node scripts/build-templates.mjs --check",
    "build:showcase": "npm --prefix showcase run build",
    "package:quickshare": "node scripts/package-quickshare.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:screenshots": "node scripts/smoke-screenshots.mjs",
    "check": "npm run build:templates:check && npm run check:contrast && npm run check:tokens",
    "tokens": "node scripts/tokens.mjs",
    "check:tokens": "node scripts/tokens.mjs --check"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
